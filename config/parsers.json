{
  "parsers": [
    {
      "name": "capital_one",
      "priority": 100,
      "match": {
        "from_contains": ["capitalone.com", "capital one"],
        "subject_contains": ["capital one"]
      },
      "field_patterns": {
        "date": ["(?P<date>\\b(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\s+\\d{1,2},\\s+\\d{4}\\b)", "(?P<date>\\b\\d{1,2}/\\d{1,2}/\\d{2,4}\\b)"],
        "merchant": ["(?:merchant|purchase at|transaction at|charged at|payment to)\\s*[:\\-]?\\s*(?P<merchant>[A-Za-z0-9&.'\\/\\- ]{2,})"],
        "amount": ["(?:amount|total|purchase amount|charged)\\s*[:\\-]?\\s*\\$?(?P<amount>\\d{1,3}(?:,\\d{3})*(?:\\.\\d{2})?)"],
        "last4": ["(?:ending in|card)\\D{0,12}(?P<last4>\\d{4})"]
      }
    },
    {
      "name": "capital_one_zelle",
      "priority": 110,
      "match": {
        "from_contains": ["capitalone@notification.capitalone.com", "notification.capitalone.com"],
        "subject_contains": ["zelle"]
      },
      "content_block_selector": "#m_-5746832775708897921body > div:nth-child(1) > table > tbody > tr > td > table:nth-child(5) > tbody > tr > td > p",
      "content_block_description": "Target the paragraph content in the provided Capital One email HTML block where the Zelle transaction details appear.",
      "field_patterns": {
        "date": [
          "(?P<date>\\b(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\s+\\d{1,2},\\s+\\d{4}\\b)",
          "(?P<date>\\b\\d{1,2}/\\d{1,2}/\\d{2,4}\\b)"
        ],
        "merchant": [
          "(?:to|from)\\s+(?P<merchant>[A-Za-z0-9&.'@\\/\\- ]{2,})"
        ],
        "amount": [
          "(?:sent|received|payment|request).{0,80}?\\$?(?P<amount>-?\\d{1,3}(?:,\\d{3})*(?:\\.\\d{2})?)",
          "\\$(?P<amount>-?\\d{1,3}(?:,\\d{3})*(?:\\.\\d{2})?)"
        ],
        "last4": [
          "(?:ending in|account ending in|last 4)\\D{0,12}(?P<last4>\\d{4})"
        ]
      }
    },
    {
      "name": "generic",
      "priority": 0,
      "match": {},
      "field_patterns": {}
    }
  ]
}
