      "field_patterns": {
        "date": ["(?P<date>\\b(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\s+\\d{1,2},\\s+\\d{4}\\b)", "(?P<date>\\b\\d{1,2}/\\d{1,2}/\\d{2,4}\\b)"],
        "merchant": ["(?:merchant|purchase at|transaction at|charged at|payment to)\\s*[:\\-]?\\s*(?P<merchant>[A-Za-z0-9&.'\\/\\- ]{2,})"],
        "amount": ["(?:amount|total|purchase amount|charged)\\s*[:\\-]?\\s*\\$?(?P<amount>\\d{1,3}(?:,\\d{3})*(?:\\.\\d{2})?)"],
        "last4": ["(?:ending in|card)\\D{0,12}(?P<last4>\\d{4})"]
      }
    },
    {
      "name": "generic",
      "priority": 0,
      "match": {},
      "field_patterns": {}
    }
  ]
